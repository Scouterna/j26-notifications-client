# Local development environment variables
# Copy to .env.local to customize local development.
# The /notifications/** proxy defaults to localhost:8000 in development.
# Set J26_NOTIFICATIONS_UPSTREAM only if you need to override that default.

# Local development runs the sender app at the root path.
# Override only if you explicitly want to emulate the deployed subpath locally.
J26_SERVICE_BASE_PATH=/

# Same-origin prefix that points to the notifications backend.
J26_NOTIFICATIONS_PROXY_PREFIX=/notifications

# Default tenant used when submitting notifications.
J26_NOTIFICATIONS_TENANT=jamboree26

# Optional override for the local backend in development.
J26_NOTIFICATIONS_UPSTREAM=http://localhost:8000
